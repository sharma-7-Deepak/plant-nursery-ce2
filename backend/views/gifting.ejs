<!-- Gifting Page -->
<div class="page-header hero-gradient">
    <div class="floating-leaves">
        <div class="leaf leaf-1"><i class="fas fa-gift"></i></div>
        <div class="leaf leaf-2"><i class="fas fa-leaf"></i></div>
        <div class="leaf leaf-3"><i class="fas fa-seedling"></i></div>
    </div>
    <div class="container">
        <h1 class="glowing-text animate fade-up">Plant Gifting</h1>
        <p class="page-subtitle gradient-text animate fade-up delay-2">Thoughtful green gifts for every occasion</p>
    </div>
    </div>

<section class="gifting-intro">
    <div class="container">
        <div class="glass-morphism animate fade-up">
            <h2 class="gradient-text">Why Gift Plants?</h2>
            <p>Plants are living, growing reminders of your care. Perfect for birthdays, anniversaries, housewarmings, corporate gifting and more.</p>
        </div>
    </div>
</section>

<section class="gifting-options">
    <div class="container">
        <div class="gifting-grid">
            <div class="gift-card glass-morphism animate fade-up delay-1">
                <div class="gift-icon gradient-icon"><i class="fas fa-seedling"></i></div>
                <h3 class="gradient-text">Curated Plant Sets</h3>
                <p>Beautifully paired plants and planters, ready to gift with a handwritten note.</p>
                <button class="btn btn-primary btn-glow">Explore Sets</button>
            </div>
            <div class="gift-card glass-morphism animate fade-up delay-2">
                <div class="gift-icon gradient-icon"><i class="fas fa-mug-hot"></i></div>
                <h3 class="gradient-text">Personalized Notes</h3>
                <p>Add your message and we’ll include a premium note card inside the box.</p>
                <button class="btn btn-secondary">Add a Note</button>
            </div>
            <div class="gift-card glass-morphism animate fade-up delay-3">
                <div class="gift-icon gradient-icon"><i class="fas fa-truck"></i></div>
                <h3 class="gradient-text">Nationwide Delivery</h3>
                <p>Timely, careful delivery with unboxing instructions for the recipient.</p>
                <button class="btn btn-primary btn-glow">See Delivery Options</button>
            </div>
        </div>
    </div>
</section>

<section class="gifting-cta">
    <div class="container">
        <div class="cta-card glass-morphism animate fade-up">
            <h2 class="gradient-text">Corporate and Bulk Gifting</h2>
            <p>Surprise teams and clients with sustainable, memorable gifts. Custom branding and bulk pricing available.</p>
            <div>
                <a href="/contact" class="btn btn-outline btn-large">Contact Sales</a>
                <a href="/products" class="btn btn-primary btn-large btn-glow">Shop Gifts</a>
            </div>
        </div>
    </div>
</section>

<style>
.gifting-intro { padding: 3rem 0; background: var(--light-bg); }
.gifting-options { padding: 3rem 0; }
.gifting-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; }
.gift-card { text-align:center; padding:2rem; }
.gift-icon { font-size: 2rem; margin-bottom: 0.75rem; }
.gifting-cta { padding: 3rem 0; background: var(--light-bg); }
.cta-card { display:flex; flex-direction:column; gap:1rem; align-items:center; text-align:center; padding:2.5rem; }
</style>

