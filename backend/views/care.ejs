<!-- Plant Care Guide -->
<div class="page-header hero-gradient">
    <div class="floating-leaves">
        <div class="leaf leaf-1"><i class="fas fa-leaf"></i></div>
        <div class="leaf leaf-2"><i class="fas fa-seedling"></i></div>
        <div class="leaf leaf-3"><i class="fas fa-leaf"></i></div>
        <div class="leaf leaf-4"><i class="fas fa-sun"></i></div>
        <div class="leaf leaf-5"><i class="fas fa-tint"></i></div>
    </div>
    <div class="container">
        <h1 class="glowing-text animate fade-up">Plant Care Guide</h1>
        <p class="page-subtitle gradient-text animate fade-up delay-2">Water, light, soil, and seasonal tips to keep your plants thriving</p>
    </div>
</div>

<section class="care-guide-section">
    <div class="container">
        <div class="tips-grid">
            <div class="tip-card glass-morphism animate fade-up delay-1">
                <div class="tip-icon"><i class="fas fa-tint"></i></div>
                <h3>Watering</h3>
                <p>Most plants prefer the soil to dry slightly between waterings. Water deeply until excess drains out, then wait until the top inch of soil is dry.</p>
            </div>
            <div class="tip-card glass-morphism animate fade-up delay-2">
                <div class="tip-icon"><i class="fas fa-sun"></i></div>
                <h3>Light</h3>
                <p>Bright, indirect light works for most houseplants. Avoid harsh midday sun through glass which can scorch leaves.</p>
            </div>
            <div class="tip-card glass-morphism animate fade-up delay-3">
                <div class="tip-icon"><i class="fas fa-leaf"></i></div>
                <h3>Soil</h3>
                <p>Use well-draining potting mix; add perlite for aeration. Succulents and cacti need extra drainage.</p>
            </div>
            <div class="tip-card glass-morphism animate fade-up delay-4">
                <div class="tip-icon"><i class="fas fa-thermometer-half"></i></div>
                <h3>Climate</h3>
                <p>Keep temps between 18-24°C (65-75°F). Avoid drafts and sudden temperature changes.</p>
            </div>
            <div class="tip-card glass-morphism animate fade-up delay-5">
                <div class="tip-icon"><i class="fas fa-bug"></i></div>
                <h3>Pests</h3>
                <p>Check leaf undersides regularly. Treat early with insecticidal soap or neem oil.</p>
            </div>
            <div class="tip-card glass-morphism animate fade-up delay-6">
                <div class="tip-icon"><i class="fas fa-seedling"></i></div>
                <h3>Feeding</h3>
                <p>Fertilize lightly during spring and summer. Reduce or stop in fall and winter.</p>
            </div>
        </div>
    </div>
    </section>

<!-- Category-specific Care Cards -->
<section class="care-categories-section">
    <div class="container">
        <h2 class="gradient-text animate fade-up">Care by Plant Type</h2>
        <div class="care-category-grid">
            <div class="care-category-card glass-morphism animate fade-up delay-1">
                <div class="care-category-icon gradient-icon"><i class="fas fa-home"></i></div>
                <h3 class="gradient-text">Indoor</h3>
                <ul class="care-list">
                    <li><strong>Water:</strong> When top 2-3 cm soil is dry</li>
                    <li><strong>Light:</strong> Bright, indirect</li>
                    <li><strong>Soil:</strong> Well‑draining mix with perlite</li>
                    <li><strong>Fertilizer:</strong> Monthly in spring/summer</li>
                </ul>
            </div>
            <div class="care-category-card glass-morphism animate fade-up delay-2">
                <div class="care-category-icon gradient-icon"><i class="fas fa-tree"></i></div>
                <h3 class="gradient-text">Outdoor</h3>
                <ul class="care-list">
                    <li><strong>Water:</strong> 2–3×/week; daily in heat</li>
                    <li><strong>Light:</strong> 4–6 hrs direct morning sun</li>
                    <li><strong>Soil:</strong> Rich loam with compost</li>
                    <li><strong>Fertilizer:</strong> Balanced NPK every 4–6 weeks</li>
                </ul>
            </div>
            <div class="care-category-card glass-morphism animate fade-up delay-3">
                <div class="care-category-icon gradient-icon"><i class="fas fa-cactus"></i></div>
                <h3 class="gradient-text">Succulents</h3>
                <ul class="care-list">
                    <li><strong>Water:</strong> Every 2–3 weeks (dry out fully)</li>
                    <li><strong>Light:</strong> Bright light, some direct</li>
                    <li><strong>Soil:</strong> Cactus mix with sand/perlite</li>
                    <li><strong>Fertilizer:</strong> Half‑strength, monthly in growth</li>
                </ul>
            </div>
            <div class="care-category-card glass-morphism animate fade-up delay-4">
                <div class="care-category-icon gradient-icon"><i class="fas fa-spa"></i></div>
                <h3 class="gradient-text">Flowering</h3>
                <ul class="care-list">
                    <li><strong>Water:</strong> Keep evenly moist</li>
                    <li><strong>Light:</strong> 4–6 hrs bright light</li>
                    <li><strong>Soil:</strong> Fertile, well‑draining</li>
                    <li><strong>Fertilizer:</strong> High‑phosphorus during bloom</li>
                </ul>
            </div>
            <div class="care-category-card glass-morphism animate fade-up delay-5">
                <div class="care-category-icon gradient-icon"><i class="fas fa-pagelines"></i></div>
                <h3 class="gradient-text">Herbs</h3>
                <ul class="care-list">
                    <li><strong>Water:</strong> When top 1–2 cm is dry</li>
                    <li><strong>Light:</strong> 6+ hrs sun (window/balcony)</li>
                    <li><strong>Soil:</strong> Light mix with compost</li>
                    <li><strong>Fertilizer:</strong> Light monthly feeding</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<style>
.care-categories-section { padding: 3rem 0; background: var(--light-bg); }
.care-category-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; }
.care-category-card { padding: 1.5rem; }
.care-category-icon { font-size: 1.6rem; margin-bottom: 0.5rem; }
.care-list { list-style: none; color: var(--text-color); line-height: 1.8; }
.care-list li { margin: 0.25rem 0; }
</style>

