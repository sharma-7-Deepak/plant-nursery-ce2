<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- Dynamic page title -->
    <title><%= pageTitle || 'Plant Nursery - Premium Plants & Garden Supplies' %></title>
    
    <!-- Meta description for SEO -->
    <meta name="description" content="<%= metaDescription || 'Discover premium plants, garden supplies, and expert care tips at our online plant nursery. From indoor houseplants to outdoor garden varieties.' %>">
    
    <!-- Open Graph meta tags for social sharing -->
    <meta property="og:title" content="<%= pageTitle || 'Plant Nursery - Premium Plants & Garden Supplies' %>">
    <meta property="og:description" content="<%= metaDescription || 'Discover premium plants and garden supplies at our online plant nursery.' %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= canonicalUrl || 'https://plantnursery.com' %>">
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    
    <!-- CSS Files -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
    
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <!-- Navigation Header -->
    <nav class="navbar" id="navbar">
        <div class="nav-container">
            <!-- Logo -->
            <div class="nav-logo">
                <a href="/">
                    <i class="fas fa-leaf"></i>
                    <span>PlantNursery</span>
                </a>
            </div>
            
            <!-- Navigation Links -->
            <ul class="nav-menu" id="navMenu">
                <li class="nav-item">
                    <a href="/" class="nav-link <%= currentPage === 'home' ? 'active' : '' %>">
                        <i class="fas fa-home"></i> Home
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/products" class="nav-link <%= currentPage === 'products' ? 'active' : '' %>">
                        <i class="fas fa-seedling"></i> Products
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/categories" class="nav-link <%= currentPage === 'categories' ? 'active' : '' %>">
                        <i class="fas fa-list"></i> Categories
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/gifting" class="nav-link <%= currentPage === 'gifting' ? 'active' : '' %>">
                        <i class="fas fa-gift"></i> Gifting
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/about" class="nav-link <%= currentPage === 'about' ? 'active' : '' %>">
                        <i class="fas fa-info-circle"></i> About
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/services" class="nav-link <%= currentPage === 'services' ? 'active' : '' %>">
                        <i class="fas fa-tools"></i> Services
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/contact" class="nav-link <%= currentPage === 'contact' ? 'active' : '' %>">
                        <i class="fas fa-envelope"></i> Contact
                    </a>
                </li>
            </ul>
            
            <!-- Cart and Search Icons -->
            <div class="nav-icons">
                <!-- Search Icon -->
                <button class="nav-icon" id="searchToggle" aria-label="Toggle search">
                    <i class="fas fa-search"></i>
                </button>
                
                <!-- Cart Icon -->
                <button class="nav-icon cart-icon" id="cartToggle" aria-label="View cart">
                    <i class="fas fa-shopping-cart"></i>
                    <span class="cart-count" id="cart-count">0</span>
                </button>
                
                <!-- User / Auth -->
                <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                    <div class="nav-user dropdown">
                        <i class="fas fa-user"></i>
                        <span class="nav-username"><%= currentUser.name.split(' ')[0] %></span>
                        <button id="logoutBtn" class="btn btn-link">Logout</button>
                    </div>
                <% } else { %>
                    <a href="/login" class="nav-link">Login</a>
                <% } %>

                <!-- Mobile Menu Toggle -->
                <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>
        
        <!-- Search Bar (hidden by default) -->
        <div class="search-bar" id="searchBar">
            <div class="search-container">
                <input type="text" id="searchInput" placeholder="Search for plants..." autocomplete="off">
                <button id="searchButton" aria-label="Search">
                    <i class="fas fa-search"></i>
                </button>
                <button id="clearSearch" class="clear-search" aria-label="Clear search">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="search-suggestions" id="searchSuggestions"></div>
        </div>
    </nav>
    
    <!-- Main Content Area -->
    <main class="main-content">
<!-- Hero Section -->
<section class="hero">
    <div class="hero-content">
        <h1 class="hero-title">Welcome to PlantNursery</h1>
        <p class="hero-subtitle">Discover premium plants and transform your space into a green paradise</p>
        <div class="hero-buttons">
            <a href="/products" class="btn btn-primary btn-glow btn-large">Shop Now</a>
            <a href="/categories" class="btn btn-outline btn-large">Browse Categories</a>
        </div>
    </div>
    <div class="hero-stats">
        <div class="stat">
            <div class="stat-number"><%= stats.totalProducts || 0 %></div>
            <div class="stat-label">Premium Plants</div>
        </div>
        <div class="stat">
            <div class="stat-number"><%= (stats.averageRating || 0) %></div>
            <div class="stat-label">Average Rating</div>
        </div>
        <div class="stat">
            <div class="stat-number"><%= stats.totalReviews || 0 %></div>
            <div class="stat-label">Happy Customers</div>
        </div>
    </div>
</section>

<!-- Categories Section -->
<section class="categories-section">
    <div class="container">
        <h2 class="section-title">Shop by Category</h2>
        <p class="section-subtitle">Find the perfect plants for your space and lifestyle</p>
        
        <div class="categories-grid">
            <% categories.forEach(category => { %>
                <div class="category-card">
                    <a href="/products?category=<%= category.name %>">
                        <div class="category-icon">
                            <% if (category.name === 'indoor') { %>
                                <i class="fas fa-home"></i>
                            <% } else if (category.name === 'outdoor') { %>
                                <i class="fas fa-tree"></i>
                            <% } else if (category.name === 'flowering') { %>
                                <i class="fas fa-flower"></i>
                            <% } else if (category.name === 'succulent') { %>
                                <i class="fas fa-cactus"></i>
                            <% } else { %>
                                <i class="fas fa-leaf"></i>
                            <% } %>
                        </div>
                        <h3><%= category.name.charAt(0).toUpperCase() + category.name.slice(1) %> Plants</h3>
                        <p><%= category.count %> varieties available</p>
                        <span class="category-link">
                            Explore <i class="fas fa-arrow-right"></i>
                        </span>
                    </a>
                </div>
            <% }) %>
        </div>
    </div>
</section>

<!-- Featured Products Section -->
<section class="featured-section">
    <div class="container">
        <h2 class="section-title">Featured Plants</h2>
        <p class="section-subtitle">Handpicked favorites that are perfect for any plant lover</p>
        
        <div class="products-grid">
            <% featuredProducts.forEach(product => { %>
                <div class="product-card" data-product-id="<%= product.id %>">
                    <div class="product-image">
                        <% if (product.image) { %>
                            <img src="<%= product.image %>" alt="<%= product.name %>" loading="lazy">
                        <% } else { %>
                            <div class="placeholder-image">
                                <i class="fas fa-seedling"></i>
                            </div>
                        <% } %>
                        
                        <% if (product.discount > 0) { %>
                            <div class="product-badge discount">-<%= product.discount %>%</div>
                        <% } else if (product.badge) { %>
                            <div class="product-badge <%= product.badge.replace(/\s+/g, '-').toLowerCase() %>">
                                <%= product.badge %>
                            </div>
                        <% } %>
                        
                        <div class="product-actions">
                            <button class="quick-view-btn" onclick="openQuickView(<%= product.id %>)" aria-label="Quick view">
                                <i class="fas fa-eye"></i>
                            </button>
                            <button class="add-to-cart-btn" onclick="addToCart(<%= product.id %>)" aria-label="Add to cart" <% if (!product.inStock) { %>disabled<% } %>>
                                <i class="fas fa-shopping-cart"></i>
                            </button>
                        </div>
                    </div>
                    
                    <div class="product-info">
                        <h3 class="product-name">
                            <a href="/products/<%= product.id %>"><%= product.name %></a>
                        </h3>
                        
                        <div class="product-rating">
                            <div class="stars">
                                <% for (let i = 1; i <= 5; i++) { %>
                                    <i class="fas fa-star <%= i <= product.rating ? 'filled' : '' %>"></i>
                                <% } %>
                            </div>
                            <span class="rating-text">(<%= product.reviews %>)</span>
                        </div>
                        
                        <div class="product-price">
                            <% if (product.originalPrice && product.originalPrice > product.price) { %>
                                <span class="original-price">$<%= product.originalPrice.toFixed(2) %></span>
                            <% } %>
                            <span class="current-price">$<%= product.price.toFixed(2) %></span>
                        </div>
                        
                        <div class="product-meta">
                            <span class="care-level <%= product.care %>">
                                <i class="fas fa-leaf"></i> <%= product.care %> care
                            </span>
                            <span class="size">
                                <i class="fas fa-ruler"></i> <%= product.size %>
                            </span>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
        
        <div class="section-footer">
            <a href="/products" class="btn btn-primary btn-glow">View All Products</a>
        </div>
    </div>
</section>

<!-- Popular Products Section -->
